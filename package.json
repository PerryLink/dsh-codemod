{
  "name": "dsh-codemod",
  "version": "3.0.0",
  "description": "Plugin-author upgrade skill for DeepSeek Harness: one package, one corridor index - the scanner detects the caller peer band and routes to the matching closed corridor card (0.1.3-alpha.1 -> 0.1.5-rc.1 as legs A+B, 0.1.5-rc.2 -> 0.1.6-alpha.2 as leg C, and 0.1.6-alpha.2/0.1.7 -> 0.2.x as leg D), with a zero-dependency seam scanner shipped as a bundle skill and an npx CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-codemod.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-codemod#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-codemod/issues"
  },
  "author": "PerryLink",
  "private": false,
  "type": "module",
  "main": "./index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.mjs"
    },
    "./scan": {
      "types": "./types.d.ts",
      "default": "./lib/scan.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-codemod": "./scripts/scan-0.1.5.mjs",
    "dsh-plugin-upgrade-scan": "./scripts/scan-0.1.5.mjs"
  },
  "files": [
    "index.mjs",
    "types.d.ts",
    "lib",
    "scripts",
    "skills",
    "docs",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "SECURITY.md",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "LICENSE",
    "STANDARDS.md",
    "MIGRATION.md"
  ],
  "sideEffects": false,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "standards": {
      "schema": "dsh-levels/1",
      "entry": {
        "status": "not-run",
        "evidence": null
      },
      "flow": {
        "status": "not-run",
        "evidence": null
      },
      "boost": {
        "status": "not-measured",
        "evidence": null
      }
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:read"
    ],
    "compatibility": {
      "dshVersions": [
        "0.1.6-alpha.2",
        "0.1.7-alpha.2",
        "0.1.7-rc.1",
        "0.1.7-rc.2",
        "0.2.1-alpha.1",
        "0.2.1-rc.2",
        "0.2.2-alpha.2"
      ]
    },
    "capability": {
      "id": "plugin-upgrade",
      "kind": "service",
      "invocation": "ctx.skills.get('plugin-upgrade') resolves a complete SkillDefinition",
      "expected": "the session skill catalog lists plugin-upgrade and the loaded body carries the corridor index (lib/route.mjs) with all three closed corridor cards - legAB 0.1.3-alpha.1 -> 0.1.5-rc.1, legC 0.1.5-rc.2 -> 0.1.6-alpha.2, and legD 0.1.6-alpha.2/0.1.7 -> 0.2.x - over a directory resourceBase"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin-upgrade",
    "migration",
    "skill",
    "version-card",
    "scanner",
    "client-slots"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.1.6-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "tsc -p tsconfig.check.json",
    "typecheck:ci": "tsc -p tsconfig.check.ci.json",
    "typecheck:checkout": "tsc -p tsconfig.checkout.json --noEmit",
    "scan": "node scripts/scan-0.1.5.mjs",
    "check:readmes": "node scripts/check-readme-sync.mjs",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify": "npm test && node scripts/check-readme-sync.mjs && node scripts/verify-self-contained.mjs && node scripts/verify-artifacts.mjs"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
